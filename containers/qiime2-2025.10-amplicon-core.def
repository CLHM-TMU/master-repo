Bootstrap: docker
From: condaforge/miniforge3:latest

%files
    envs/qiime2-2025.10-amplicon-core.yaml /opt/envs/qiime2-2025.10-amplicon-core.yaml

%post
    conda env create -f /opt/envs/qiime2-2025.10-amplicon-core.yaml -p /opt/conda-env
    conda clean -afy

%environment
    export PATH=/opt/conda-env/bin:$PATH

%runscript
    exec "$@"

%labels
    Source envs/qiime2-2025.10-amplicon-core.yaml

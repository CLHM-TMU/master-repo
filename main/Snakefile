print("="*50)

# At the top of your main Snakefile, after defining directories
def p(path):
    """Convert Path object to string for Snakemake compatibility"""
    return str(path)

# Global directories
SNAKEFILE_DIR = Path.cwd()  # current working directory
REPO_ROOT = SNAKEFILE_DIR.parent
MAIN_DIR = REPO_ROOT / "main"
WORK_DIR = REPO_ROOT / "work"
REF_DIR = REPO_ROOT / "reference"

# Define study-specific directories
STUDY_DIR = WORK_DIR / study_name
RAW_DIR = STUDY_DIR / "raw_data"
QIIME_DIR = STUDY_DIR / "qiime2_artifacts"
PLOTS_DIR = STUDY_DIR / "plots"
TABLES_DIR = STUDY_DIR / "tables"

# In your main Snakefile, after defining directories:
print(f"DEBUG: SNAKEFILE_DIR = {SNAKEFILE_DIR}")
print(f"DEBUG: REPO_ROOT = {REPO_ROOT}")
print(f"DEBUG: STUDY_DIR = {STUDY_DIR}")
print(f"DEBUG: Expected metadata path = {STUDY_DIR / 'metadata.tsv'}")

metadata_path = STUDY_DIR / "metadata.tsv"
print(f"DEBUG: metadata.tsv exists? {os.path.exists(metadata_path)}")
print(f"DEBUG: Absolute path: {metadata_path.absolute()}")

# Define second level of directories
TAXA_BARPLOT_DIR = PLOTS_DIR / "taxa_barplots"
DIVERSITY_DIR = PLOTS_DIR / "diversity"
DIFFERENTIAL_ABUNDANCE_DIR = PLOTS_DIR / "differential_abundance"
CORE_METRICS_DIR = QIIME_DIR / "core-metrics-results"

# Define conda environments
QIIME_CONDA_ENV = MAIN_DIR / "envs/qiime2-2025.10-amplicon-core.yaml"
GREENGENES2_CONDA_ENV = MAIN_DIR / "envs/qiime2-2025.10-amplicon-Greengenes2.yaml"

rule make_dirs:
    output:
        marker = p(STUDY_DIR / ".dirs_created")
    run:
        STUDY_DIR.mkdir(parents=True, exist_ok=True)
        RAW_DIR.mkdir(parents=True, exist_ok=True)
        QIIME_DIR.mkdir(parents=True, exist_ok=True)
        PLOTS_DIR.mkdir(parents=True, exist_ok=True)
        TABLES_DIR.mkdir(parents=True, exist_ok=True)
        TAXA_BARPLOT_DIR.mkdir(parents=True, exist_ok=True)
        DIVERSITY_DIR.mkdir(parents=True, exist_ok=True)
        DIFFERENTIAL_ABUNDANCE_DIR.mkdir(parents=True, exist_ok=True)
        CORE_METRICS_DIR.mkdir(parents=True, exist_ok=True)
        # create a dummy file to mark completion
        with open(output.marker, "w") as f:
            f.write("done")



###############################################
# STEP 1 — Build Manifest
###############################################

rule generate_manifest:
    input:
        make_dirs_marker = STUDY_DIR / ".dirs_created"
    output:
        manifest_file = STUDY_DIR / "manifest.tsv"
    params:
        raw_dir = RAW_DIR,
        sequence_type = sequence_type,
        region = region,
        study_dir = STUDY_DIR
    log:
        "logs/generate_manifest.log"
    conda:
        QIIME_CONDA_ENV
    script:
        "scripts/build_manifest.py"

###############################################
# STEP 2 - Trimming (Cutadapt) and Denoising (DADA2)
###############################################
if sequence_type not in ["NGS", "TGS"]:
    raise ValueError("sequence_type must be 'NGS' or 'TGS'.")

include: f"rules/{sequence_type}.smk"

###############################################
# STEP 3 - Taxonomy Classification and Phylogeny Construction
###############################################
allowed_reference_dbs = ["Greengenes2", "SILVA138", "NCBI"]
# Validate
for db in reference_db:
    if db not in allowed_reference_dbs:
        raise ValueError(f"Invalid reference_db '{db}'. "
                         f"Allowed: {allowed_dbs}")

print(f"DEBUG: File exists? {os.path.exists(f'rules/{sequence_type}.smk')}")
# Dynamically include rule files
for db in reference_db:
    include: f"rules/{db}.smk"

print(f"DEBUG: Finished including rules/{sequence_type}.smk")
print(f"DEBUG: Checking if NGS_dada2 rule exists...")
try:
    print(f"DEBUG: rules.NGS_dada2 = {rules.NGS_dada2}")
except:
    print("DEBUG: NGS_dada2 rule NOT FOUND!")

##############################################
# STEP 4 - Alpha and Beta Diversity Analyses
##############################################
# Get rarefaction depth from previous step
def read_rarefy_depth(wildcards):
    import csv
    csv_file = TABLES_DIR / "rarefy_depth.csv"
    with open(csv_file) as f:
        reader = csv.DictReader(f)
        row = next(reader)
        return int(row["rarefaction_depth"])

rule rarefy_table:
    input:
        table = p(QIIME_DIR / "table.qza")
    output:
        rarefied_table = p(QIIME_DIR / "rarefied-table.qza")
    params:
        depth = lambda wildcards: read_rarefy_depth(wildcards)
    conda:
        QIIME_CONDA_ENV  
    shell:
        """
        echo "Rarefying feature table to depth {params.depth}..."
        qiime feature-table rarefy \
            --i-table {input.table} \
            --p-sampling-depth {params.depth} \
            --o-rarefied-table {output.rarefied_table}
        """
include: "rules/diversity.smk"


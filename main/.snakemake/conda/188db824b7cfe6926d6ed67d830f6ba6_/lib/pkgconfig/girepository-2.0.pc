prefix=/home/patwuch/Documents/projects/Core-Lab-of-Human-Microbiome-TMU/main/.snakemake/conda/188db824b7cfe6926d6ed67d830f6ba6_
bindir=${prefix}/bin
datadir=${prefix}/share
includedir=${prefix}/include
libdir=${prefix}/lib

gidatadir=${datadir}/gobject-introspection-1.0
girdir=${datadir}/gir-1.0
typelibdir=${libdir}/girepository-1.0
gi_compile_repository=${bindir}/gi-compile-repository

Name: girepository
Description: GObject Introspection repository parser
Version: 2.86.2
Requires: glib-2.0, gobject-2.0
Requires.private: gmodule-no-export-2.0, gio-2.0, libffi >=  3.0.0
Libs: -L${libdir} -lgirepository-2.0
Libs.private: -lm
Cflags: -I${includedir}

import csv

def read_trunc_len(wildcards):
    csv_file = QIIME_DIR / "trunc_len.csv"
    with open(csv_file) as f:
        reader = csv.DictReader(f)
        row = next(reader)  # Only one line after the header
        return {
            "trunc_len_f": int(row["trunc_len_f"]),
            "trunc_len_r": int(row["trunc_len_r"])
        }

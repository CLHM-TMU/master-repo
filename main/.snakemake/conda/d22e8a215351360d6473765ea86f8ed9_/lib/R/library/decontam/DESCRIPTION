Package: decontam
Type: Package
Title: Identify Contaminants in Marker-gene and Metagenomics Sequencing
        Data
Version: 1.22.0
Date: 2021-02-19
Authors@R: 
    c(person(given = "Benjamin", family = "Callahan", role = c("aut","cre"),

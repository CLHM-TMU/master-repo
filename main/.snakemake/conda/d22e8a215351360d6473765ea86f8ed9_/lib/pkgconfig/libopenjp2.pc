prefix=/home/patwuch/Documents/projects/Core-Lab-of-Human-Microbiome-TMU/main/.snakemake/conda/d22e8a215351360d6473765ea86f8ed9_
bindir=${prefix}/bin
mandir=${prefix}/share/man
docdir=${prefix}/share/doc/openjpeg
libdir=${prefix}/lib
includedir=${prefix}/include/openjpeg-2.5

Name: openjp2
Description: JPEG2000 library (Part 1 and 2)
URL: http://www.openjpeg.org/
Version: 2.5.2
Libs: -L${libdir} -lopenjp2
Libs.private: -lm
Cflags: -I${includedir}
Cflags.private: -DOPJ_STATIC

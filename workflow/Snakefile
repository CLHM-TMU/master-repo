# Alpha diversity outputs using wildcards
alpha_outputs = expand(
    ALPHA_DIR / "{db}_alpha_{group}.png",
    db=reference_db,
    group=GROUPING_AXES
)

alpha_sentinels = expand(
    DIVERSITY_DIR / ".{db}_alpha_{group}_done",
    db=reference_db,
    group=GROUPING_AXES
)

# Beta diversity outputs using wildcards

prefix=/home/patwuch/Documents/projects/Core-Lab-of-Human-Microbiome-TMU/main/.snakemake/conda/d22e8a215351360d6473765ea86f8ed9_
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

KDB5_DB_LIB=

Name: kdb
Description: Kerberos database access libraries
Version: 1.21.3
Requires.private: mit-krb5-gssapi mit-krb5 gssrpc
Cflags: -I${includedir}
Libs: -L${libdir} -lkdb5
Libs.private: ${KDB5_DB_LIB}
